:root {
  color-scheme: dark;
  --bg:#000;
  --panel:#090b12;
  --line:#23283a;
  --text:#f5f7ff;
  --muted:#8f98ad;
  --accent:#8cff00;
  --accent2:#c45cff;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;touch-action:none;overscroll-behavior:none;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button{font:inherit;color:var(--text);background:#101522;border:1px solid #2b3348;border-radius:12px}
button:active{transform:scale(.96);background:#192134}
.app-shell{
  width:100%;height:100vh;height:100dvh;max-width:760px;margin:0 auto;
  padding:max(env(safe-area-inset-top),6px) 8px max(env(safe-area-inset-bottom),5px);
  display:grid;grid-template-rows:42px 58px minmax(0,1fr) 52px 32px;gap:5px;background:#000;overflow:hidden;
}
.hud-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:0}
.stat{display:flex;flex-direction:column;line-height:1.05}.stat span,.preview-box>span,.mini-stats,.timer small{font-size:11px;color:var(--muted)}
.stat strong{font-size:16px}.timer{text-align:center;display:flex;flex-direction:column;line-height:1.05}.timer strong{font-size:23px;letter-spacing:.5px}.timer small{margin-top:2px}
.icon-button{justify-self:end;width:42px;height:38px;padding:0}
.preview-strip{min-width:0;display:grid;grid-template-columns:68px minmax(0,1fr) 60px;gap:5px;align-items:stretch}
.preview-box{position:relative;min-width:0;overflow:hidden;border:1px solid #242c42;border-radius:10px;background:#060910;padding:14px 3px 2px}
.preview-box>span{position:absolute;left:7px;top:3px;line-height:1}
.preview-box canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
.hold-box{padding-left:2px;padding-right:2px;cursor:pointer}
.next-box canvas{max-width:100%}
.mini-stats{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px;border:1px solid #242c42;border-radius:10px;background:#060910;text-align:center;white-space:nowrap}
.mini-stats b{display:block;color:var(--text);font-size:15px}
.game-stage{min-width:0;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
.board-wrap{position:relative;flex:none;aspect-ratio:1/2;border:1px solid #30384f;background:#05070b;overflow:hidden;box-shadow:0 0 0 1px #111827 inset}
#board{width:100%;height:100%;display:block;image-rendering:pixelated}
.overlay{position:absolute;inset:0;background:rgba(0,0,0,.82);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px}.overlay.hidden{display:none}.overlay h1{font-size:22px}.overlay button{width:70%;padding:10px}
.combo-pop{position:absolute;left:50%;bottom:18%;transform:translateX(-50%);font-weight:800;font-size:22px;color:white;text-shadow:0 0 12px var(--accent2);pointer-events:none;white-space:nowrap}
.controls{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;min-height:0}.controls button{height:52px;min-width:0;padding:0;font-size:23px;font-weight:700}.controls.hidden{display:none}
.bottom-bar{display:flex;align-items:center;justify-content:space-between;gap:6px;min-height:0}.bottom-bar button{height:30px;padding:0 10px;font-size:12px}.bottom-bar span{font-size:11px;color:var(--muted);text-align:right;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.board-wrap.shake-small{animation:shake-small .09s linear}.board-wrap.shake-strong{animation:shake-strong .16s linear}
@keyframes shake-small{25%{transform:translateX(-2px)}75%{transform:translateX(2px)}}
@keyframes shake-strong{20%{transform:translateX(-6px)}40%{transform:translateX(5px)}60%{transform:translateX(-4px)}80%{transform:translateX(3px)}}
@media (min-width:700px){
  .app-shell{grid-template-rows:48px 68px minmax(0,1fr) 60px 36px;padding-left:18px;padding-right:18px;gap:7px}
  .preview-strip{grid-template-columns:88px minmax(0,1fr) 78px}.controls button{height:60px;font-size:26px}.bottom-bar button{height:34px}
}
@media (max-height:760px){
  .app-shell{grid-template-rows:36px 48px minmax(0,1fr) 46px 28px;gap:3px;padding-top:max(env(safe-area-inset-top),3px);padding-bottom:max(env(safe-area-inset-bottom),3px)}
  .timer strong{font-size:20px}.preview-strip{grid-template-columns:58px minmax(0,1fr) 54px}.preview-box{padding-top:12px}.controls button{height:46px;font-size:21px}.bottom-bar button{height:26px}.icon-button{height:34px;width:38px}
}
@media (orientation:landscape) and (max-height:600px){.app-shell::before{content:"세로 화면으로 돌려줘";position:fixed;inset:0;z-index:100;background:#000;display:flex;align-items:center;justify-content:center;font-size:22px}.app-shell>*{visibility:hidden}}
